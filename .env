# ============================================================
#   CONFIGURATION MARIADB (Base de données principale)
# ============================================================
MARIADB_ROOT_PASSWORD=example          # Mot de passe root
MARIADB_DATABASE=useradvicesmariadb    # Nom de la base
MARIADB_USER=app_user                  # Utilisateur applicatif
MARIADB_PASSWORD=app_pass              # Mot de passe applicatif
MARIADB_PORT=3308                      # Port exposé (localhost:3308)

# ============================================================
#   CONFIGURATION ADMINER (Interface simple)
# ============================================================
ADMINER_PORT=9080                      # Accessible sur http://localhost:9080

# ============================================================
#   CONFIGURATION PHPMYADMIN (Interface avancée)
# ============================================================
PHPMYADMIN_PORT=9090                   # Accessible sur http://localhost:9090
PMA_HOST=db                            # Service Docker de la base
PMA_PORT=3306                          # Port interne MariaDB

# ============================================================
#   CONFIGURATION SMTP4DEV (Serveur mail de test)
# ============================================================
SMTP4DEV_HTTP_PORT=5001                # Interface web http://localhost:5001
SMTP4DEV_SMTP_PORT=2526                # Port SMTP (localhost:2526)
SMTP4DEV_IMAP_PORT=1153                # Port IMAP (localhost:1153)
SMTP4DEV_POP3_PORT=1120                # Port POP3 (localhost:1120)
SMTP4DEV_HOSTNAME=smtp4dev             # Nom d’hôte interne
SMTP4DEV_MAILBOX=hello@world.com       # Mailbox par défaut
SMTP4DEV_DB=database.db                # Fichier DB interne
SMTP4DEV_MESSAGES_KEEP=100             # Nombre max de messages conservés
SMTP4DEV_SESSIONS_KEEP=50              # Nombre max de sessions conservées

# ============================================================
#   CONFIGURATION SPRING BOOT (Backend applicatif)
# ============================================================
SERVER_PORT=9191                       # Accessible sur http://localhost:9191

